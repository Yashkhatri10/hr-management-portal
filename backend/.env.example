# development or production
APP_ENV=development
APP_NAME=HR Management Portal
APP_TIMEZONE=Asia/Kolkata
SEED_DEMO_DATA=true

# Local SQLite is suitable only for development. Use a managed PostgreSQL URL for production.
DATABASE_URL=sqlite:///./hr_portal.db

# Use a cryptographically random secret of at least 32 characters in production.
# Never commit your real secret to source control.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Comma-separated trusted frontend origins.
CORS_ORIGINS=http://localhost:5173

OFFICE_LATITUDE=28.513393
OFFICE_LONGITUDE=77.072276
OFFICE_GEOFENCE_RADIUS_METERS=900
MAX_GPS_ACCURACY_METERS=900
AUTO_CHECKOUT_ON_GEOFENCE_EXIT=true
AUTO_LOGOUT_ON_GEOFENCE_EXIT=false
GEOFENCE_MONITOR_INTERVAL_SECONDS=30
GEOFENCE_EXIT_CONFIRMATIONS=3
GEOFENCE_EXIT_GRACE_PERIOD_SECONDS=120
